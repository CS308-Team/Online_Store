JWT_SECRET=change-me

# SHOP-154: SMTP settings for the invoice e-mail.
# The defaults send to the local test server: python -m aiosmtpd -n -l localhost:1025
# For a real mailbox (e.g. Gmail: smtp.gmail.com, 587, TLS true, an app password) fill these in.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=store@example.com
SMTP_TIMEOUT=10
